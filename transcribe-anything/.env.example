# OpenAI is the default provider and requires this key.
OPENAI_API_KEY=

# Provider and model. For audio.cpp, change both values to "audiocpp" and a
# model ID configured in its server (for example, qwen3-asr).
TRANSCRIBE_ANYTHING_PROVIDER=openai
TRANSCRIBE_ANYTHING_MODEL=gpt-4o-transcribe-diarize

# Used only by the audio.cpp provider. The server must already be running.
TRANSCRIBE_ANYTHING_AUDIOCPP_BASE_URL=http://127.0.0.1:8080

# Optional defaults.
TRANSCRIBE_ANYTHING_OUTPUT_DIR=outputs
TRANSCRIBE_ANYTHING_MAX_SOURCE_MB=2048
TRANSCRIBE_ANYTHING_CHUNK_SECONDS=240
TRANSCRIBE_ANYTHING_HOST=127.0.0.1
TRANSCRIBE_ANYTHING_PORT=8765
TRANSCRIBE_ANYTHING_RETENTION_HOURS=24

# Optional explicit path. When unset, PATH and imageio-ffmpeg are checked.
TRANSCRIBE_ANYTHING_FFMPEG=
